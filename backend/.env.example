APP_NAME=Didaskey API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./didaskey.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
FRONTEND_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
IMAGEBB_API_KEY=your_imagebb_api_key_here

# Paystack — obtain from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
# Signature verification uses PAYSTACK_SECRET_KEY.
SKIP_TUTOR_AVAILABILITY_CHECK=false

# LiveKit — video classroom
# Obtain from https://cloud.livekit.io or your self-hosted LiveKit server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
